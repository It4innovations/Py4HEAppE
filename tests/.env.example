# Example environment variables for running live CLI tests
# Populate values in tests/.env or export the variables in your environment.

# Test control
PY4HEAPPE_RUN_LIVE_CLI_TESTS=
PY4HEAPPE_TEST_RUN_MUTATING_COMMANDS=
PY4HEAPPE_TEST_SESSION_CODE=

# Core required values
PY4HEAPPE_TEST_URL=
PY4HEAPPE_TEST_PROJECT=

# Auth / CLI config
# Credentials used by auth-related CLI tests. Do NOT commit real secrets.
CREDENTIALS_USERNAME=
CREDENTIALS_PASSWORD=
CREDENTIALS_TOKEN=

# Job management & transfer
PY4HEAPPE_TEST_JOB_SPEC_FILE=
PY4HEAPPE_TEST_SUBMIT_JOB_ID=
PY4HEAPPE_TEST_CANCEL_JOB_ID=
PY4HEAPPE_TEST_DELETE_JOB_ID=
PY4HEAPPE_TEST_INFO_JOB_ID=
PY4HEAPPE_TEST_COPY_TO_TEMP_JOB_ID=
PY4HEAPPE_TEST_COPY_TO_TEMP_PATH=
PY4HEAPPE_TEST_COPY_FROM_TEMP_JOB_ID=
PY4HEAPPE_TEST_TEMP_SESSION_CODE=
PY4HEAPPE_TEST_SUBMITTED_TASK_ID=

# File transfer specific
PY4HEAPPE_TEST_SINGLE_TRANSFER_JOB_ID=
PY4HEAPPE_TEST_SINGLE_TRANSFER_TASK_ID=   # Semicolon-separated list supported
PY4HEAPPE_TEST_INTERACTIVE_TRANSFER_JOB_ID=
PY4HEAPPE_TEST_INTERACTIVE_TRANSFER_TASK_ID=
PY4HEAPPE_TEST_DOWNLOAD_JOB_ID=
PY4HEAPPE_TEST_DOWNLOAD_RELATIVE_FILE_PATH=
PY4HEAPPE_TEST_DOWNLOAD_PARTS_JOB_ID=
PY4HEAPPE_TEST_TASK_FILE_OFFSETS=          # Semicolon-separated offsets for partial downloads
PY4HEAPPE_TEST_LIST_CHANGED_JOB_ID=
PY4HEAPPE_TEST_STREAM_JOB_ID=
PY4HEAPPE_TEST_STREAM_TASK_ID=

# Command templates and parameters
PY4HEAPPE_TEST_CLUSTER_NODE_TYPE_ID=
PY4HEAPPE_TEST_GENERIC_COMMAND_TEMPLATE_ID=
PY4HEAPPE_TEST_MODIFY_COMMAND_TEMPLATE_ID=
PY4HEAPPE_TEST_MODIFY_FROM_GENERIC_COMMAND_TEMPLATE_ID=
PY4HEAPPE_TEST_REMOVE_COMMAND_TEMPLATE_ID=
PY4HEAPPE_TEST_COMMAND_TEMPLATE_PARAMETER_ID=
PY4HEAPPE_TEST_CREATE_PARAMETER_COMMAND_TEMPLATE_ID=
PY4HEAPPE_TEST_MODIFY_PARAMETER_ID=
PY4HEAPPE_TEST_REMOVE_PARAMETER_ID=

# Reporting & information
PY4HEAPPE_TEST_USER_ID=
PY4HEAPPE_TEST_GROUP_ID=
PY4HEAPPE_TEST_REPORT_JOB_ID=

# Notes:
# - Leave values blank if not applicable for the subset of tests you plan to run.
# - Do NOT commit real credentials or session tokens into source control.
